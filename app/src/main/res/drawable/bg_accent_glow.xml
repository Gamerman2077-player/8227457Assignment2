<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#33FF35C8"/>
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="#FF36C8"
                android:endColor="#B940FF"/>
        </shape>
    </item>

</layer-list>