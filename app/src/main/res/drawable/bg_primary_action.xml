<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape>
            <solid android:color="#35FF28B8" />
            <corners android:radius="17dp" />
        </shape>

    </item>

    <item>

        <shape>

            <gradient
                android:angle="0"
                android:startColor="#FF287F"
                android:centerColor="#E018C6"
                android:endColor="#AF00FF" />

            <corners android:radius="17dp" />

        </shape>

    </item>

</layer-list>